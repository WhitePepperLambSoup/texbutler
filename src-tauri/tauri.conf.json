{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TeXButler",
  "version": "0.5.0",
  "identifier": "com.texbutler.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TeXButler",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' http://tb-file.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://tb-file.localhost; frame-src 'self' http://tb-file.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": null,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/bin/tectonic.exe": "bin/tectonic.exe",
      "resources/bundle/*": "bundle/"
    }
  }
}

